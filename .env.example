# Core settings. Replace every value marked CHANGE_ME before starting.
APP_ENV=selfhosted
APP_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
DATABASE_URL=sqlite:///./data/spark.db

# The first account registered with this email becomes the administrator.
ADMIN_EMAIL=you@example.com

# Optional independent mailbox for terminal task failures. Empty disables it.
# This does not change the administrator login email or user preferences.
TASK_FAILURE_ADMIN_EMAIL=

# Optional public website filing labels. Use your own approved numbers.
# These are frontend build settings; rebuild frontend after changing them.
NEXT_PUBLIC_ICP_NUMBER=
NEXT_PUBLIC_PUBLIC_SECURITY_NUMBER=

# Initial invitation used to create the first account. Change it after use.
BOOTSTRAP_INVITE=CHANGE_ME_PRIVATE_INVITE
BOOTSTRAP_INVITE_USES=1

# Browser entry point. Keep 127.0.0.1 for this computer only; use 0.0.0.0 for LAN access.
SPARK_BIND_ADDRESS=127.0.0.1
SPARK_PORT=3000
# Compose only: recycle after a browser run; requires restart: unless-stopped.
SPARK_RECYCLE_AFTER_RUN=1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SESSION_COOKIE_NAME=spark_session
SESSION_SECURE=false
SESSION_DAYS=30

# false: show a one-time code in the page, suitable for a private single-user instance.
# true: require SMTP and send registration/password-reset codes by email.
EMAIL_VERIFICATION_REQUIRED=false
DEBUG_RETURN_CODES=false

# Optional email service. Start Compose with --profile mail after configuring it.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true

