BOOTSTRAP_INVITE_USES=20
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true
EMAIL_VERIFICATION_REQUIRED=false
DEBUG_RETURN_CODES=false
