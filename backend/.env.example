APP_ENV=development
APP_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=sqlite:///./data/spark.db
ALLOWED_ORIGINS=http://localhost:3000
SESSION_COOKIE_NAME=spark_session
SESSION_SECURE=false
SESSION_DAYS=30
